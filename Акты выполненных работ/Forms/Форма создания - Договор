async function onContractChange(): Promise<void> {
  const contractRef = Context.data.contract_name;
  if (!contractRef) return;

  const contract = await contractRef.fetch();
  const { deal_client, deal_affiliation, deal_company_in, deal_company_out } = contract.data;

  if (!deal_client) return;

  const client = await deal_client.fetch();
  Context.data.client = client.data.__name;

  const isAffiliated = !!deal_affiliation;
  const companyRefs = isAffiliated ? deal_company_in : deal_company_out;

  if (companyRefs && companyRefs.length > 0) {
    const companies = await Promise.all(companyRefs.map(ref => ref.fetch()));
    const names = companies.map(c => c.data.__name);
    
    // Only include entries where INN exists
    const innsFormatted = companies
      .map(c => {
        const inn = isAffiliated ? c.data._inn : c.data.identification_number;
        return inn ? `${c.data.__name} - ${inn}` : null;
      })
      .filter(Boolean); // Remove null entries

    Context.data.contractor = names.join(", ");
    Context.data.identification_number = innsFormatted.join(", ");
  }
}
