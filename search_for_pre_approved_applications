async function search_for_pre_approved_applications(): Promise<boolean> {
    if (Context.data.company_a === true) {
       let company = await Context.fields.company.app.search().where(f => f.company_a.eq(true)).first();
       Context.data.company = company;
    }
    if (Context.data.company_b === true) {
       let company = await Context.fields.company.app.search().where(f => f.company_b.eq(true)).first();
       Context.data.company = company;
    }
    if (Context.data.company_c === true) {
       let company = await Context.fields.company.app.search().where(f => f.company_c.eq(true)).first();
       Context.data.company = company;
    }

        const orders_amount = await Application.search()
            .where((f, g) => g.and(
                g.or(
                    f.__status.eq(Application.fields.__status.variants.pre_approved),
                    f.__status.eq(Application.fields.__status.variants.final_approval)
                ),
                f.__deletedAt.eq(null),
                f.company.link(Context.data.company!)
            ))
            .count();

        return orders_amount > 0;
}
