// Cобытие "Ежедневный платеж" - Создание
async function create_daily_payment(): Promise<void> {
    const app = Context.fields.daily_payment.app.create()
    app.data.__participants = Context.data.daily_payment_users
    app.data.__startAt = Context.data.daily_payment_start
    app.data.__endAt = Context.data.daily_payment_end
    // app.data.cash_request_table = Context.data.cash_request_table_accountant
    app.data.payment_request_table = Context.data.payment_request_table_accountant
    await app.save()
    Context.data.daily_payment = app
}

