// Заявки на оплату - Установить статус заявок "Утверждение"
async function change_status_to_approval(): Promise<void> {
    const approverTable = Context.data.payment_request_table_approver!;

    for (const approverEntry of approverTable) {
        try {
            // Получение связанной заявки
            const paymentRequest = await approverEntry.daily_payment_request!.fetch();
            // Установка статуса "approver"
            await paymentRequest.setStatus(Application.fields.__status.variants.approver);
        } catch {
            // Ошибка игнорируется, чтобы не прерывать обработку остальных записей
        }
    }
}

// Функция для присвоения Пользователей из Групп и ролей в Зоны отвественности бизнес-процесса
async function getUsersFromGroup(): Promise<void> {
    if (Context.data.company_a === true) {
        const groupPaymentApprover = await System.userGroups.search()
            .where(f => f.__name.eq('Утверждающий_A'))
            .first();
        Context.data.payment_approver = await groupPaymentApprover?.users();
    } else {
        if (Context.data.company_b === true) {
            const groupPaymentApprover = await System.userGroups.search()
                .where(f => f.__name.eq('Утверждающий_B'))
                .first();
            Context.data.payment_approver = await groupPaymentApprover?.users();
        } else {
            if (Context.data.company_c === true) {
                const groupPaymentApprover = await System.userGroups.search()
                    .where(f => f.__name.eq('Утверждающий_C'))
                    .first();
                Context.data.payment_approver = await groupPaymentApprover?.users();
            }
        }
    }

    // Запись пользователей для рассылки на случай отмены
    Context.data.cancelation_mail_list = Context.data.payment_approver ?? [];
}
