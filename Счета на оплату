const approver_group_code = '9df3b544-a4ba-41a5-8591-e66a28b42154'
const accountant_group_code = '47e4dd0e-16f0-4e37-a6f7-ef1e19763835'

async function search_for_applications(): Promise<boolean> {
    const orders_amount = await Application.search()
        .where((f, g) => g.and(
            g.or(
                f.__status.eq(Application.fields.__status.variants.approved),
                f.__status.eq(Application.fields.__status.variants.approver)
            ),
            f.__deletedAt.eq(null)
        ))
        .count();

    return orders_amount > 0;
}

// Событие "Ежедневный платеж" - Определение параметров 
async function define_daily_payment_parameters(): Promise<void> {
    // Определение дат для события "Ежедневные платежи"
    Context.data.daily_payment_start = new Datetime()
    const seconds_from = Context.data.daily_payment_start.getTime().hours * 3600 + Context.data.daily_payment_start.getTime().minutes * 60 + Context.data.daily_payment_start.getTime().seconds
    Context.data.daily_payment_start = Context.data.daily_payment_start.add(new Duration(-seconds_from, 'seconds'))
    Context.data.daily_payment_end = Context.data.daily_payment_start.addDate(0, 0, 1)
    // Определение участников для события "Ежедневные платежи"
    // Ищем группы по коду (approver_group_code, accountant_group_code)
    const approver = await System.userGroups.search().size(10000).where(gr => gr.code.eq(approver_group_code)).first()
    const accountant = await System.userGroups.search().size(10000).where(gr => gr.code.eq(accountant_group_code)).first()
    // Добавляем участников найденных групп в участники события "Ежедневные платежи"
    if (accountant) {
        Context.data.daily_payment_users = await accountant!.users()
        if (approver) {
            Context.data.daily_payment_users = (Context.data.daily_payment_users || []).concat((await approver.users()))
        }
    }
    else {
        if (approver) {
            Context.data.daily_payment_users = (Context.data.daily_payment_users || []).concat((await approver.users()))
        }
    }
}

// Таблица утверждающего - Занесение заявок 
async function approver_table_input(): Promise<void> {
    // Запрос всех заказов с состоянием 'approver' и не удаленных (null __deletedAt)
    const all_orders = await Application.search()
        .size(10000)
        .where((f, g) => g.and(
                g.or(
                    f.__status.eq(Application.fields.__status.variants.approved), 
                    f.__status.eq(Application.fields.__status.variants.approver)
                ),
                f.__deletedAt.eq(null)
            ))
        .all();

  // Перебор всех заказов в обратном порядке (от последнего к первому)
  for (let i = all_orders.length - 1; i >= 0; i--) {
    const order = all_orders[i];
    
    // Получаем данные о компании
    const companyObject = await order.data.company?.fetch();
    const companyName = companyObject?.fields.__name.name;
    
    // Проверяем соответствие компании выбранным фильтрам
    let isCompanySelected = false;
    
    // Проверка для company_a
    if (Context.data.company_a === true && companyName === "ITS Ltd.") {
      isCompanySelected = true;
    } 
    // Проверка для company_b
    else if (Context.data.company_b === true && companyName === "ITS Tech Ltd.") {
      isCompanySelected = true;
    }
    // Проверка для company_c
    else if (Context.data.company_c === true && companyName === "ITS CSD Ltd.") {
      isCompanySelected = true;
    }
    
    // Если компания не соответствует фильтрам, пропускаем заказ
    if (!isCompanySelected) {
      continue;
    }
    
    // Создаем запись в таблице payment_request_table_approver для отобранного заказа
    const payment_request_table = Context.data.payment_request_table_approver!.insert();
    
    // Заполняем поля записи данными из заказа
    payment_request_table.daily_payment_request = order;
    payment_request_table.currency_of_payment = order.data.currency_of_payment!;
    payment_request_table.sum_of_payment = order.data.sum_of_payment!;
    payment_request_table.payment_desired_date = order.data.payment_desired_date!;
    payment_request_table.payment_request_comment = order.data.payment_request_comment!;
    payment_request_table.payment_request_initiator = order.data._createdBy;
    payment_request_table.payment_reason_file = order.data.payment_reason_file!;
    payment_request_table.contract = order.data.contract!;
    payment_request_table.payee_partner_fix = order.data.payee_partner!;
  }
}

// Заявки на оплату - Смена статусов
async function change_approvement_statuses(): Promise<void> {
    for (let i = Context.data.cash_request_table_approver!.length - 1; i >= 0; i--) {
        const table_request = Context.data.cash_request_table_approver![i]
        if (table_request.approve) {
            const request = await table_request.daily_payment_request!.fetch()
            await request.setStatus(Application.fields.__status.variants.payment_approved)
            Context.data.approved_request_users!.unshift(table_request.payment_request_initiator)
        }
        if (table_request.refused) {
            const request = await table_request.daily_payment_request!.fetch()
            await request.setStatus(Application.fields.__status.variants.payment_refused)
            Context.data.refused_request_users!.unshift(table_request.payment_request_initiator)
        }
    }
    for (let i = Context.data.payment_request_table_approver!.length - 1; i >= 0; i--) {
        const table_request = Context.data.payment_request_table_approver![i]
        if (table_request.approve) {
            const request = await table_request.daily_payment_request!.fetch()
            await request.setStatus(Application.fields.__status.variants.payment_approved)
            Context.data.approved_request_users!.unshift(table_request.payment_request_initiator)
        }
        if (table_request.refused) {
            const request = await table_request.daily_payment_request!.fetch()
            await request.setStatus(Application.fields.__status.variants.payment_refused)
            Context.data.refused_request_users!.unshift(table_request.payment_request_initiator)
        }
    }
}

